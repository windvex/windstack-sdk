{
  "name": "@windstack/session",
  "version": "2.1.0",
  "description": "Runtime-neutral Antelope signer session and wallet-plugin orchestration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@windstack/antelope": "2.1.0"
  },
  "sideEffects": false,
  "keywords": [
    "windstack",
    "antelope",
    "wallet",
    "session",
    "provider",
    "signing",
    "typescript"
  ],
  "license": "MIT",
  "author": "Gilang Ramadan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windvex/windstack-sdk.git",
    "directory": "packages/session"
  },
  "homepage": "https://github.com/windvex/windstack-sdk/tree/main/packages/session#readme",
  "bugs": {
    "url": "https://github.com/windvex/windstack-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
