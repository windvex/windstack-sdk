{
  "name": "@windstack/vexanium",
  "version": "2.3.4",
  "description": "Vexanium SDK client for wallet connection, ABI-aware transactions, resource requirements and funding quotes, VSR, chain presets, and VEX EVM utilities.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./antelope": {
      "types": "./dist/antelope.d.ts",
      "import": "./dist/antelope.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@windstack/antelope": "2.3.4",
    "@windstack/abi": "2.3.4",
    "@windstack/core": "2.3.4",
    "@windstack/crypto": "2.3.4",
    "@windstack/evm": "2.3.4",
    "@windstack/rpc": "2.3.4",
    "@windstack/signing-request": "2.3.4"
  },
  "sideEffects": false,
  "keywords": [
    "windstack",
    "vexanium",
    "vex",
    "bridge",
    "provider",
    "wallet",
    "antelope",
    "vsr",
    "signing-request",
    "transaction",
    "typescript"
  ],
  "license": "MIT",
  "author": "Gilang Ramadan",
  "homepage": "https://github.com/windvex/windstack-sdk/tree/main/packages/vexanium#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windvex/windstack-sdk.git",
    "directory": "packages/vexanium"
  },
  "bugs": {
    "url": "https://github.com/windvex/windstack-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
