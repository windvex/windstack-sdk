{
  "name": "@windstack/account",
  "version": "2.0.0",
  "description": "Common Antelope account, balance, permission, and system-action helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@windstack/contract": "2.0.0",
    "@windstack/crypto": "2.0.0",
    "@windstack/rpc": "2.0.0"
  },
  "sideEffects": false,
  "keywords": [
    "windstack",
    "antelope",
    "account",
    "staking",
    "ram",
    "voting",
    "contract",
    "transaction",
    "typescript"
  ],
  "license": "MIT",
  "author": "Gilang Ramadan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windvex/windstack-sdk.git",
    "directory": "packages/account"
  },
  "homepage": "https://github.com/windvex/windstack-sdk/tree/main/packages/account#readme",
  "bugs": {
    "url": "https://github.com/windvex/windstack-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
