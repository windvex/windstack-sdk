{
  "name": "@windstack/signing-request",
  "version": "2.1.0",
  "description": "Vexanium Signing Request primitives for actions, multi-action transactions, identity, callbacks, resolution, and verification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@windstack/abi": "2.1.0",
    "@windstack/antelope": "2.1.0",
    "@windstack/crypto": "2.1.0",
    "@windstack/rpc": "2.1.0",
    "pako": "^2.2.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4"
  },
  "sideEffects": false,
  "keywords": [
    "windstack",
    "vexanium",
    "antelope",
    "vsr",
    "signing-request",
    "wallet",
    "transaction",
    "typescript"
  ],
  "license": "MIT",
  "author": "Gilang Ramadan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windvex/windstack-sdk.git",
    "directory": "packages/signing-request"
  },
  "homepage": "https://github.com/windvex/windstack-sdk/tree/main/packages/signing-request#readme",
  "bugs": {
    "url": "https://github.com/windvex/windstack-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
